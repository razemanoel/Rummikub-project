# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored (see root .gitignore's ".env" rule) —
# never commit real AWS credentials.
#
# If these are left unset, the app falls back to storing vision
# feedback images on local disk (backend/vision/feedback_dataset/raw)
# instead of S3 — useful for running the project without an AWS account.

# --- IAM user credentials (from the "rummikub-backend" IAM user) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- S3 bucket used to store vision-feedback rack/board photos ---
S3_BUCKET_NAME=
# Optional: key prefix inside the bucket (default shown below)
# S3_FEEDBACK_PREFIX=vision-feedback/raw
