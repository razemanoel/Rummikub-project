# API Configuration for Expo

# Development on same machine
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Development on physical phone/different machine
# Replace with your backend server IP address (use ipconfig on Windows)
# EXPO_PUBLIC_API_URL=http://192.168.1.YOUR_IP:3000/api

# Production/deployed backend
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api

